# Backend
ENVIRONMENT=development
BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cloudshare-files
R2_REGION=auto
R2_ENDPOINT_URL=

# D1 / SQLite
DATABASE_URL=sqlite+aiosqlite:///./cloudshare.db

# Limits
MAX_FILE_SIZE_BYTES=104857600
DEFAULT_SHARE_EXPIRES_HOURS=168

# Cloudflare Containers / D1 REST API
# Set CF_CONTAINER=1 when running as a Cloudflare Container to use the D1 REST API
CF_CONTAINER=0
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CF_D1_DATABASE_ID=951b7f52-83ff-4b5e-b881-cb72820e4e4e
CLOUDFLARE_D1_TOKEN=